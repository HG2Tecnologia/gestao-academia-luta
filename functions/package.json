{
  "name": "sensei-manager-functions",
  "description": "Cloud Functions do Sensei Manager",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/domain.test.js test/temp-password.test.js test/graduacao.test.js",
    "test:rules": "firebase emulators:exec --project sensei-manager-test --only firestore,auth \"node --test test/firestore.rules.test.js\"",
    "test:identity": "firebase emulators:exec --project sensei-manager-test --only functions,firestore,auth \"node --test test/account-functions.test.js\"",
    "test:admin": "firebase emulators:exec --project sensei-manager-test --only functions,firestore,auth \"node --test test/admin-functions.test.js\"",
    "test:graduacao": "firebase emulators:exec --project sensei-manager-test --only functions,firestore,auth \"node --test test/graduacao-functions.test.js\"",
    "test:turma": "firebase emulators:exec --project sensei-manager-test --only functions,firestore,auth \"node --test test/turma-functions.test.js\"",
    "test:finance": "firebase emulators:exec --project sensei-manager-test --only functions,firestore,auth \"node --test test/finance-functions.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.6.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  },
  "private": true
}
