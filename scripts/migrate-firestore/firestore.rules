rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Busca info do usuário autenticado
    function userInfo() {
      return get(/databases/$(database)/documents/usuariosFirebase/$(request.auth.uid)).data;
    }

    function isAuth() {
      return request.auth != null;
    }

    function pertenceAcademia(academiaId) {
      return isAuth() && (
        userInfo().get('academiaId', '') == academiaId ||
        userInfo().get('academy_ids', []).hasAny([academiaId])
      );
    }

    function possuiPerfilNaAcademia(academiaId, perfis) {
      return pertenceAcademia(academiaId) && (
        (userInfo().get('academiaId', '') == academiaId &&
         perfis.hasAny([userInfo().get('perfil', '')])) ||
        userInfo().get('roles_by_academy', {}).get(academiaId, []).hasAny(perfis)
      );
    }

    function isAdminOuSecretaria(academiaId) {
      return possuiPerfilNaAcademia(academiaId, ['Admin', 'Secretaria']);
    }

    function isProfessor(academiaId) {
      return possuiPerfilNaAcademia(academiaId, ['Professor']);
    }

    function isSelfRegisteredAcademyAccount(uid) {
      return request.auth.uid == uid &&
        request.resource.data.get('schemaVersion', 0) == 2 &&
        request.resource.data.get('uid', '') == uid &&
        request.resource.data.get('status', '') == 'active' &&
        request.resource.data.get('perfil', '') == 'Admin' &&
        request.resource.data.get('academy_ids', []).size() == 1 &&
        request.resource.data.get('profile_keys', []).size() == 1 &&
        request.resource.data.get('roles_by_academy', {})
          .get(request.resource.data.get('academiaId', ''), []).hasOnly(['Admin']) &&
        getAfter(/databases/$(database)/documents/academias/$(request.resource.data.get('academiaId', ''))/usuarios/$(request.resource.data.get('usuarioId', '')))
          .data.get('firebase_uid', '') == uid;
    }

    // Lookup Firebase UID → academia
    match /usuariosFirebase/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      // Primeiro Acesso e sincronização são feitos por Cloud Functions. A
      // única criação client-side aceita é o Admin da própria academia que
      // está sendo criada no mesmo batch.
      allow create: if isAuth() && isSelfRegisteredAcademyAccount(uid);
      allow update: if false;
      allow delete: if false;
    }

    // Conquistas globais (read-only para todos autenticados)
    match /conquistas/{doc} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Dados da academia — qualquer membro pode ler; escrita restrita por role
    match /academias/{academiaId} {
      allow read: if pertenceAcademia(academiaId);
      allow update: if isAdminOuSecretaria(academiaId);
      allow delete: if false;
      allow create: if isAuth() &&
        request.resource.data.created_by_uid == request.auth.uid;
    }

    // Permite criar o primeiro usuário Admin durante o registro da academia
    match /academias/{academiaId}/usuarios/{usuarioId} {
      allow create: if isAuth() &&
        request.resource.data.firebase_uid == request.auth.uid &&
        request.resource.data.perfil == 0 &&
        getAfter(/databases/$(database)/documents/academias/$(academiaId))
          .data.created_by_uid == request.auth.uid;
      allow read: if pertenceAcademia(academiaId);
      // O próprio aluno só altera campos não privilegiados depois que a
      // Function já confirmou seu vínculo.
      allow update: if isAdminOuSecretaria(academiaId) ||
        (isAuth() &&
         resource.data.get('firebaseUid', resource.data.get('firebase_uid', '')) == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fotoBase64', 'atualizado_em', 'faixaPrincipalModalidadeId']));
      allow delete: if isAdminOuSecretaria(academiaId);
    }

    match /academias/{academiaId}/funcionarios/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow create, delete: if isAdminOuSecretaria(academiaId);
      allow update: if isAdminOuSecretaria(academiaId);
    }

    // Presencas: qualquer membro pode criar (self-checkin) e ler
    match /academias/{academiaId}/presencas/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow create: if pertenceAcademia(academiaId);
      allow update, delete: if isAdminOuSecretaria(academiaId) || isProfessor(academiaId);
    }

    // Atestados e PAR-Q: aluno pode criar o próprio
    match /academias/{academiaId}/atestados/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow create: if pertenceAcademia(academiaId);
      allow update: if isAdminOuSecretaria(academiaId);
      allow delete: if false;
    }

    match /academias/{academiaId}/par_qs/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow create, update: if pertenceAcademia(academiaId);
      allow delete: if false;
    }

    // Conquistas do aluno: aluno pode marcar como vistas
    match /academias/{academiaId}/conquistas_aluno/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow update: if pertenceAcademia(academiaId);
      allow create, delete: if isAdminOuSecretaria(academiaId);
    }

    // Notificações: membro pode marcar como lida
    match /academias/{academiaId}/notificacoes/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow update: if pertenceAcademia(academiaId);
      allow create, delete: if isAdminOuSecretaria(academiaId);
    }

    // Respostas de pesquisa: qualquer membro pode criar (self-submit)
    match /academias/{academiaId}/respostas_pesquisa/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow create: if pertenceAcademia(academiaId);
      allow update, delete: if isAdminOuSecretaria(academiaId);
    }

    // Turmas: exclusão é sempre lógica (soft delete) via Cloud Function
    // `arquivarTurma`, nunca hard delete pelo cliente — preserva presenças,
    // graduações e horários históricos ligados ao turma_id.
    match /academias/{academiaId}/turmas/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow create, update: if isAdminOuSecretaria(academiaId);
      allow delete: if false;
    }

    // Trilha de auditoria de ações administrativas sensíveis (redefinição de
    // senha etc.). Só Cloud Functions escrevem, com o Admin SDK — que
    // ignora estas regras. Cliente nunca escreve; leitura restrita a
    // Admin/Secretaria da própria academia.
    match /academias/{academiaId}/auditoria/{doc} {
      allow read: if isAdminOuSecretaria(academiaId);
      allow write: if false;
    }

    // Resto: admin/secretaria gerencia tudo; membros leem
    match /academias/{academiaId}/{colecao}/{doc} {
      allow read: if pertenceAcademia(academiaId);
      allow write: if !(colecao in ['usuarios', 'funcionarios']) &&
        (isAdminOuSecretaria(academiaId) || isProfessor(academiaId));
    }

    // Timer público — leitura aberta (TV sem login); escrita apenas pelo dono
    match /timer_sessions/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Config da academia (timer) — leitura aberta (TV); escrita apenas pelo dono
    match /timer_academia/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Configuração global do app (versão mínima, force update) — leitura pública
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
