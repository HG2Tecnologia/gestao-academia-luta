{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": {
    "rules": "scripts/migrate-firestore/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "timer-web/database.rules.json"
  },
  "hosting": {
    "target": "timer",
    "public": "timer-web",
    "ignore": ["firebase.json", "**/.*", "database.rules.json", "**/*.apk"],
    "rewrites": [
      { "source": "/", "destination": "/control.html" }
    ]
  }
}
